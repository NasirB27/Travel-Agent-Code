# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Anthropic API key for the single reasoning-action LLM call.
# Leave blank to run fully offline: the CLI falls back to a replay client that
# serves recorded responses from mock-data/recorded-llm-responses.json.
ANTHROPIC_API_KEY=

# Optional model override (default: claude-opus-5).
ANTHROPIC_MODEL=

# Impact Level: IL2 | IL4 | IL5 (default IL4). IL5 disables LLM reasoning.
IL_LEVEL=IL4

# Force offline replay even when a key is present: "offline" | "live" (default: live if key set).
LLM_MODE=
